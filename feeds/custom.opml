    <outline text="GN: 傅利叶智能"                 type="rss" xmlUrl="https://news.google.com/rss/search?q=%E5%82%85%E5%88%A9%E5%8F%B6%E6%99%BA%E8%83%BD&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />
    <outline text="GN: 优必选"                     type="rss" xmlUrl="https://news.google.com/rss/search?q=%E4%BC%98%E5%BF%85%E9%80%89&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />

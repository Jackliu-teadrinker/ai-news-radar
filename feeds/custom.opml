<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Custom Anchors — 已验证可用源</title>
  </head>
  <body>
    <!-- ══════════ 已验证可用的 RSS ══════════ -->
    <outline text="TechCrunch Robotics"  type="rss" xmlUrl="https://techcrunch.com/feed/" />
    <outline text="VentureBeat AI"       type="rss" xmlUrl="https://venturebeat.com/feed/" />
    <outline text="IEEE Spectrum"        type="rss" xmlUrl="https://spectrum.ieee.org/rss/robotics" />
    <outline text="IEEE Brain"           type="rss" xmlUrl="https://brain.ieee.org/feed/" />
    <outline text="HuggingFace Blog"     type="rss" xmlUrl="https://huggingface.co/blog/feed.xml" />
    <outline text="量子位"               type="rss" xmlUrl="https://www.qbitai.com/rss" />
    <outline text="极链AI"               type="rss" xmlUrl="https://zhidx.com/rss" />
    <outline text="Wired"                type="rss" xmlUrl="https://www.wired.com/feed/rss" />

    <!-- ══════════ Google News RSS 源 (高价值) ══════════ -->
    <outline text="GN: 人形机器人"           type="rss" xmlUrl="https://news.google.com/rss/search?q=humanoid+robot&amp;hl=en-US&amp;gl=US&amp;ceid=US:en" />
    <outline text="GN: 具身智能"             type="rss" xmlUrl="https://news.google.com/rss/search?q=embodied+intelligence+OR+embodied+AI&amp;hl=en-US&amp;gl=US&amp;ceid=US:en" />
    <outline text="GN: 脑机接口"             type="rss" xmlUrl="https://news.google.com/rss/search?q=brain+computer+interface+OR+BCI+OR+neural+interface&amp;hl=en-US&amp;gl=US&amp;ceid=US:en" />
    <outline text="GN: 机器人"               type="rss" xmlUrl="https://news.google.com/rss/search?q=robot&amp;hl=en-US&amp;gl=US&amp;ceid=US:en" />
    <outline text="GN: Physical AI"          type="rss" xmlUrl="https://news.google.com/rss/search?q=physical+AI&amp;hl=en-US&amp;gl=US&amp;ceid=US:en" />
    <outline text="GN: 人形机器人 (中文)"      type="rss" xmlUrl="https://news.google.com/rss/search?q=%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />
    <outline text="GN: 具身智能 (中文)"        type="rss" xmlUrl="https://news.google.com/rss/search?q=%E5%85%B7%E8%BA%AB%E6%99%BA%E8%83%BD&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />
    <outline text="GN: 脑机接口 (中文)"        type="rss" xmlUrl="https://news.google.com/rss/search?q=%E8%84%91%E6%9C%BA%E6%8E%A5%E5%8F%A3+OR+%E7%A5%9E%E7%BB%8F%E6%8E%A5%E5%8F%A3+OR+%E8%84%91%E7%94%B5%E6%8E%A5%E5%8F%A3+OR+%E8%84%91%E6%8E%A5%E5%8F%A3+OR+BCI&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />
    <outline text="GN: 机器人 (中文)"          type="rss" xmlUrl="https://news.google.com/rss/search?q=%E6%9C%BA%E5%99%A8%E4%BA%BA&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />
    <outline text="GN: 物理AI (中文)"          type="rss" xmlUrl="https://news.google.com/rss/search?q=%E7%89%A9%E7%90%86AI&amp;hl=zh-CN&amp;gl=CN&amp;ceid=CN:zh-Hans" />
  </body>
</opml>
